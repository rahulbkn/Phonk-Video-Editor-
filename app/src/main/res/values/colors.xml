<?xml version="1.0" encoding="utf-8"?>
<!--
    Centralized color palette — LIGHT (soft pink) design system.
    The app never references raw hex colors from code/layouts; use these
    resources so values-night/colors.xml can override them automatically.
-->
<resources>
    <!-- Core palette — PURPLE accent -->
    <color name="background">#FFF7FB</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_variant">#F3E8FF</color>
    <color name="primary">#A855F7</color>
    <color name="secondary">#C084FC</color>
    <color name="accent">#7C3AED</color>

    <color name="on_primary">#FFFFFF</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="text_primary">#2B2B2B</color>
    <color name="text_secondary">#6B6B6B</color>

    <!-- Semantic -->
    <color name="divider">#F1D8E4</color>
    <color name="error">#E53935</color>
    <color name="on_error">#FFFFFF</color>
    <color name="code_background">#FFEAF3</color>
    <color name="ripple">#33FF4D94</color>

    <!-- Extended palette -->
    <color name="lavender">#F0E8FF</color>
    <color name="success">#22C55E</color>
    <color name="success_container">#DCFCE7</color>
    <color name="warning">#F97316</color>
    <color name="warning_container">#FFEDD5</color>
    <color name="on_success">#FFFFFF</color>
    <color name="on_warning">#FFFFFF</color>

    <!-- Legacy aliases (kept for compatibility) -->
    <color name="crash_background">@color/background</color>
    <color name="crash_surface">@color/surface</color>
    <color name="crash_surface_variant">@color/surface_variant</color>
    <color name="crash_text_primary">@color/text_primary</color>
    <color name="crash_text_secondary">@color/text_secondary</color>
    <color name="crash_divider">@color/divider</color>
    <color name="crash_code_background">@color/code_background</color>
    <color name="crash_error">@color/error</color>
    <color name="crash_accent">@color/accent</color>
    <color name="crash_on_primary">@color/on_primary</color>

    <!-- Editor dark-surface colors (used in editor even in light mode) -->
    <color name="surface_elevated">#1A1A24</color>
    <color name="surface_timeline">#14141C</color>
    <color name="surface_track">#111117</color>
    <color name="surface_panel">#121219</color>
    <color name="surface_control">#17171F</color>
    <color name="border_default">#2A2A36</color>
    <color name="border_subtle">#1E1E28</color>
    <color name="border_panel">#25252E</color>
    <color name="text_ruler">#9E9EAE</color>
    <color name="text_muted">#6B6B7B</color>
    <color name="text_disabled">#B8B8C4</color>
    <color name="text_status">#6B6B7B</color>
    <color name="text_progress">#6B6B7B</color>
    <color name="text_on_surface">#1A1A24</color>
    <color name="keyframe">#7C3AED</color>
    <color name="audio_fx">#39D7B1</color>
    <color name="toolbar_bg">#0B0B10</color>
    <color name="preview_bg">#0B0B10</color>
</resources>