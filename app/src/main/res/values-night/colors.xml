<?xml version="1.0" encoding="utf-8"?>
<!--
    Centralized color palette — DARK (NOXFRAME) design system.
    Professional dark cinematic editor: near-black surfaces, pink/magenta accent.
    Automatically selected when the device is in dark mode / night mode.
    Source: noxframe_dark_editor_ui.html design specification.
-->
