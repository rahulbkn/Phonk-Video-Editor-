<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <TextView
        android:id="@+id/tv_history_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/crash_screen_padding"
        android:text="@string/crash_history_title"
        android:textSize="@dimen/crash_history_title_text"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lv_crash_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/divider"
            android:dividerHeight="@dimen/crash_divider_height"
            android:contentDescription="@string/crash_history_list_content_description" />

        <TextView
            android:id="@+id/tv_history_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/crash_body_text"
            android:text="@string/crash_no_logs"
            android:visibility="gone" />
    </FrameLayout>

    <Button
        android:id="@+id/btn_history_back"
        android:layout_width="match_parent"
        android:layout_height="@dimen/crash_button_height"
        android:layout_margin="@dimen/crash_button_margin"
        android:background="@drawable/bg_button_secondary"
        android:textColor="@color/text_primary"
        android:text="@string/crash_back" />
</LinearLayout>